---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
export async function getStaticPaths() {
	const notes = await getCollection('notes');
	return notes.map(note => ({ params:{ slug:note.slug }, props:{ note } }));
}
const { note } = Astro.props;
const { Content } = await note.render();
const date = note.data.publishDate.toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' });
---
<BaseLayout title={`${note.data.title} | Ato Arkhurst`} description={note.data.description}>
	<main class:list={['note-page', `theme-${note.data.theme}`]}>
		<header class="note-head wrapper">
			<a class="back" href="/garden/">← The Garden</a>
			<div class="status"><span>{note.data.stage}</span><span>{date}</span><span>{note.data.readingTime}</span></div>
			<p class="tags">{note.data.tags.join(' · ')}</p>
			<h1>{note.data.title}</h1>
			<p class="dek">{note.data.description}</p>
		</header>
		<div class="note-body wrapper">
			<aside><span>Field note</span><p>This piece is part of an evolving collection about the things I’m learning to notice.</p></aside>
			<article><Content /></article>
		</div>
		<footer class="note-end wrapper">
			<div><span>End note</span><p>Thanks for spending some time here.</p></div>
			{note.data.sourceUrl && <a href={note.data.sourceUrl} target="_blank" rel="noreferrer">Originally shared on Substack ↗</a>}
			<a href="/garden/">Keep wandering through the Garden →</a>
		</footer>
	</main>
	<ContactCTA />
</BaseLayout>
<style>
	.note-page { --note-accent:var(--accent); }
	.theme-light { --note-accent:#789b00; }.theme-quiet { --note-accent:#9c563a; }
	.note-head { padding-block:3rem clamp(4rem,9vw,8rem); border-bottom:1px solid var(--line); }
	.back { color:var(--ink); text-decoration:none; font-size:.85rem; }
	.status { margin:clamp(4rem,9vw,8rem) 0 2rem; display:flex; flex-wrap:wrap; gap:.6rem 1.2rem; color:var(--ink-soft); font-size:.7rem; text-transform:uppercase; letter-spacing:.12em; }
	.status span:first-child { color:var(--note-accent); font-weight:700; }
	.tags { color:var(--note-accent); font-size:.72rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
	h1 { margin-top:1rem; font-size:clamp(3.5rem,9vw,8.5rem); max-width:12ch; }
	.dek { margin-top:2rem; max-width:46ch; font-size:clamp(1.1rem,2vw,1.4rem); }
	.note-body { padding-block:clamp(4rem,9vw,8rem); display:grid; gap:3rem; }
	aside { color:var(--ink-soft); font-size:.78rem; max-width:25ch; }
	aside span,.note-end span { display:block; color:var(--note-accent); font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.13em; margin-bottom:.75rem; }
	article { min-width:0; max-width:45rem; color:var(--ink); font-size:clamp(1.05rem,1.7vw,1.2rem); line-height:1.78; }
	article :global(p) { margin:0 0 1.5rem; }
	article :global(h2) { margin:3.5rem 0 1.25rem; font-size:clamp(2rem,4vw,3.2rem); }
	article :global(em) { color:var(--note-accent); }
	article :global(blockquote) { margin:3rem 0; padding:1.5rem 0 1.5rem 1.5rem; border-left:3px solid var(--note-accent); color:var(--ink); font-family:var(--font-brand); font-size:clamp(1.35rem,3vw,2.1rem); line-height:1.25; letter-spacing:-.03em; }
	article :global(a) { color:var(--note-accent); text-underline-offset:.2em; }
	.note-end { padding-block:2rem clamp(6rem,12vw,10rem); border-top:1px solid var(--line); display:grid; gap:2rem; }
	.note-end div p { color:var(--ink); font-family:var(--font-brand); font-size:1.5rem; }
	.note-end>a { width:max-content; color:var(--ink); text-decoration:none; border-bottom:1px solid currentColor; }
	@media(min-width:50em){.note-body{grid-template-columns:minmax(10rem,1fr) 3fr}.note-body aside{position:sticky;top:2rem;height:max-content}.note-end{grid-template-columns:1fr auto;align-items:end}.note-end>a:last-child{grid-column:2}}
</style>
