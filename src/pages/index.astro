---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
const projects = (await getCollection('work')).sort((a,b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0,4);
---
<BaseLayout>
	<main>
		<section class="hero wrapper">
			<div class="eyebrow"><span class="status-dot"></span> Front-end developer · Arlington, VA</div>
			<h1>I build <span>useful things</span> for the web.</h1>
			<div class="hero-bottom">
				<p>At SIDEARM Sports, I build websites for college athletic programs. I’m especially interested in the work behind useful, lasting products that people rely on and return to.</p>
				<a href="#selected-work">Explore selected work <span>↓</span></a>
			</div>
			<div class="orbit" aria-hidden="true"><span>DESIGN • CODE • CURIOSITY • </span></div>
		</section>

		<section class="work wrapper" id="selected-work">
			<header class="section-heading"><p>01 / Selected work</p><h2>A few things<br/>I’ve helped shape.</h2></header>
			<ol class="project-grid">
				{projects.map((project,index) => <li><PortfolioPreview project={project} index={index} /></li>)}
			</ol>
			<a class="text-link" href="/work/">See the full archive <span>↗</span></a>
		</section>

		<section class="approach wrapper">
			<div class="portrait"><img src="/assets/ato-working.jpg" alt="Ato Arkhurst working at a desk" loading="lazy" /></div>
			<div class="approach-copy">
				<p class="kicker">02 / How I work</p>
				<h2>I like making ideas<br/>work for real.</h2>
				<p>The part I enjoy most is taking an idea and turning it into something I can see, use, and keep improving. I care about how things look, but I’m especially interested in how they work and whether they’re genuinely useful.</p>
				<div class="skills"><span>Front-end development</span><span>Responsive UI</span><span>Design systems</span><span>Accessibility</span></div>
				<a class="text-link" href="/about/">More about me <span>↗</span></a>
			</div>
		</section>
	</main>
	<ContactCTA />
</BaseLayout>
<style>
	.hero { min-height:calc(100svh - 6rem); padding-block:clamp(4rem,10vw,8rem) 5rem; position:relative; display:flex; flex-direction:column; justify-content:center; border-bottom:1px solid var(--line); }
	.eyebrow,.kicker,.section-heading>p { text-transform:uppercase; letter-spacing:.14em; font-size:.72rem; font-weight:600; color:var(--ink); }
	.eyebrow { display:flex; align-items:center; gap:.6rem; margin-bottom:2.5rem; }
	.status-dot { width:.55rem; height:.55rem; border-radius:50%; background:#32b86c; box-shadow:0 0 0 .3rem rgba(50,184,108,.12); }
	h1 { font-size:clamp(3.6rem,10vw,9.2rem); max-width:12ch; }
	h1 span { color:var(--accent); font-style:italic; font-weight:500; }
	.hero-bottom { display:grid; gap:1.5rem; margin-top:2.5rem; max-width:40rem; }
	.hero-bottom p { font-size:clamp(1.05rem,2vw,1.35rem); max-width:38ch; }
	.hero-bottom a,.text-link { width:max-content; color:var(--ink); text-decoration:none; padding-bottom:.3rem; border-bottom:1px solid currentColor; font-weight:600; }
	.hero-bottom a span,.text-link span { display:inline-block; margin-left:.55rem; color:var(--accent); transition:transform var(--theme-transition); }
	.hero-bottom a:hover span { transform:translateY(4px); } .text-link:hover span { transform:translate(3px,-3px); }
	.orbit { display:none; }
	.work { padding-block:clamp(6rem,12vw,11rem); }
	.section-heading { display:grid; gap:1.5rem; margin-bottom:4rem; }
	.section-heading h2,.approach h2 { font-size:var(--text-4xl); }
	.project-grid { list-style:none; margin:0 0 4rem; padding:0; display:grid; gap:3rem; }
	.approach { padding-bottom:clamp(6rem,12vw,11rem); display:grid; gap:3rem; }
	.portrait { min-height:28rem; overflow:hidden; border-radius:1.5rem; border:1px solid var(--line); background:var(--paper-deep); }
	.portrait img { width:100%; height:100%; object-fit:cover; }
	.approach-copy { display:flex; flex-direction:column; justify-content:center; align-items:flex-start; }
	.approach h2 { margin:1.5rem 0 2rem; }
	.approach-copy>p:not(.kicker) { max-width:46ch; font-size:1.12rem; }
	.skills { display:flex; flex-wrap:wrap; gap:.55rem; margin:2rem 0 2.5rem; }
	.skills span { color:var(--ink); border:1px solid var(--line); border-radius:999rem; padding:.5rem .8rem; font-size:.82rem; }
	@media(min-width:50em){
		.hero-bottom { grid-template-columns:1fr auto; align-items:end; max-width:none; }
		.hero-bottom p { margin-left:25%; }
		.orbit { display:grid; place-items:center; position:absolute; right:1rem; top:28%; width:8rem; aspect-ratio:1; border-radius:50%; background:var(--accent-2); color:#171714; font:600 .65rem/1 var(--font-brand); letter-spacing:.08em; transform:rotate(8deg); }
		.section-heading { grid-template-columns:1fr 2fr; align-items:start; }
		.project-grid { grid-template-columns:repeat(2,1fr); gap:5rem 2rem; }
		.project-grid li:nth-child(even) { transform:translateY(6rem); }
		.work>.text-link { margin-top:5rem; }
		.approach { grid-template-columns:1.05fr .95fr; gap:clamp(4rem,8vw,9rem); }
	}
