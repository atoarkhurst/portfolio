---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
interface Props { entry: CollectionEntry<'work'>; }
export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
---
<BaseLayout title={`${entry.data.title} | Ato Arkhurst`} description={entry.data.description}>
	<main>
		<header class="project-head wrapper">
			<a href="/work/">← All work</a>
			<p class="kicker">Selected project</p>
			<h1>{entry.data.title}</h1>
			<div class="meta"><p>{entry.data.description}</p><ul>{entry.data.tags.map((tag) => <li>{tag}</li>)}</ul></div>
		</header>
		<div class:list={['cover','wrapper',`theme-${entry.data.coverTheme}`]}><img src={entry.data.img} alt={entry.data.img_alt || ''} /></div>
		<article class="wrapper"><Content /></article>
		{(entry.data.liveUrl || entry.data.repoUrl) && <div class="project-links wrapper">
			{entry.data.liveUrl && <a href={entry.data.liveUrl} target="_blank" rel="noreferrer">Open the live app ↗</a>}
			{entry.data.repoUrl && <a href={entry.data.repoUrl} target="_blank" rel="noreferrer">View the code ↗</a>}
		</div>}
	</main>
	<ContactCTA />
</BaseLayout>
<style>
	.project-head { padding:4rem 0 clamp(3rem,7vw,6rem); }
	.project-head>a { display:inline-block; color:var(--ink); text-decoration:none; margin-bottom:clamp(4rem,8vw,7rem); border-bottom:1px solid currentColor; }
	.kicker { color:var(--ink); text-transform:uppercase; letter-spacing:.14em; font-size:.72rem; font-weight:600; margin-bottom:1.5rem; }
	h1 { font-size:var(--text-4xl); }
	.meta { display:grid; gap:2rem; margin-top:3rem; padding-top:2rem; border-top:1px solid var(--line); }
	.meta>p { max-width:48ch; font-size:1.15rem; }
	.meta ul { list-style:none; padding:0; margin:0; display:flex; flex-wrap:wrap; gap:.5rem; align-items:flex-start; align-self:start; }
	.meta li { border:1px solid var(--line); color:var(--ink); border-radius:99rem; padding:.45rem .75rem; font-size:.8rem; }
	.cover { background:var(--surface); border:1px solid var(--line); overflow:hidden; }
	.cover img { width:100%; max-height:75rem; object-fit:cover; }
	.cover.theme-cadence { min-height:clamp(24rem,62vw,52rem); display:grid; place-items:center; background:radial-gradient(circle at 50% 35%,#40258e 0,#1a1923 47%,#0d0d12 100%); }
	.cover.theme-cadence img { width:min(36%,24rem); object-fit:contain; filter:drop-shadow(0 2.4rem 3rem rgba(0,0,0,.45)); }
	article { width:min(100% - 2rem,47rem); padding-block:clamp(5rem,10vw,9rem); font-size:1.1rem; }
	article :global(* + *) { margin-top:1.4rem; }
	article :global(h2) { font-size:clamp(2rem,5vw,3.5rem); margin-top:4rem; }
	article :global(h3) { font-size:1.6rem; margin-top:3rem; }
	article :global(p:first-child) { color:var(--ink); font:500 clamp(1.45rem,3vw,2.1rem)/1.3 var(--font-brand); letter-spacing:-.03em; }
	article :global(ul) { padding-left:1.2rem; }
	.project-links { width:min(100% - 2rem,47rem); padding-bottom:clamp(5rem,10vw,9rem); display:flex; flex-wrap:wrap; gap:.75rem; }
	.project-links a { color:var(--paper); background:var(--ink); border-radius:99rem; padding:.85rem 1.1rem; text-decoration:none; font-weight:600; }
	@media(min-width:50em){.meta{grid-template-columns:1fr auto}.cover{border-radius:1.5rem}.project-head{padding-top:6rem}}
</style>
