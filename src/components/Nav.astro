---
import ThemeToggle from './ThemeToggle.astro';
const links = [{ label: 'Work', href: '/work/' }, { label: 'About', href: '/about/' }];
---
<header class="nav-wrap">
	<nav class="wrapper" aria-label="Primary navigation">
		<a class="identity" href="/" aria-label="Ato Arkhurst, home"><span class="mark">AA</span><span>Ato Arkhurst</span></a>
		<div class="nav-links">
			{links.map(({ label, href }) => <a class:list={['link', { active: Astro.url.pathname.startsWith(href) }]} href={href}>{label}</a>)}
			<a class="link contact" href="https://www.linkedin.com/in/atoarkhurst/" target="_blank" rel="noreferrer">Let’s talk ↗</a>
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	.nav-wrap { padding-block: 1rem; position: relative; z-index: 10; }
	nav { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
	.identity { display:flex; align-items:center; gap:.7rem; color:var(--ink); text-decoration:none; font-family:var(--font-brand); font-weight:600; letter-spacing:-.03em; }
	.mark { display:grid; place-items:center; width:2.2rem; aspect-ratio:1; border-radius:50%; color:var(--paper); background:var(--ink); font-size:.68rem; letter-spacing:-.05em; }
	.nav-links { display:flex; align-items:center; gap:.25rem; }
	.link { color:var(--ink-soft); text-decoration:none; padding:.55rem .7rem; border-radius:999px; font-size:.9rem; transition:background var(--theme-transition),color var(--theme-transition); }
	.link:hover,.link.active { color:var(--ink); background:var(--paper-deep); }
	.contact { display:none; }
	@media(min-width:40em){.nav-wrap{padding-block:1.4rem}.contact{display:block;color:var(--paper);background:var(--ink)}.contact:hover{color:var(--paper);background:var(--accent)}}
</style>
