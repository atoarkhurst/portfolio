---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Ato Arkhurst | Front-End Developer', description = 'Ato Arkhurst is a front-end developer who likes building useful products, tools, and web experiences.' } = Astro.props;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:image" content="https://ato-arkhurst-portfolio.lofty-chair-3999.chatgpt.site/og.png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content="https://ato-arkhurst-portfolio.lofty-chair-3999.chatgpt.site/og.png" />
<meta name="theme-color" content="#f4f0e8" />
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Space+Grotesk:wght@500;600&display=swap" rel="stylesheet" />
<script is:inline>
	const preference = localStorage.getItem('theme');
	document.documentElement.classList.toggle('theme-dark', preference ? preference === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches);
	new MutationObserver(() => localStorage.setItem('theme', document.documentElement.classList.contains('theme-dark') ? 'dark' : 'light')).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
</script>
